@model List<CinemaSystem.Web.Models.MovieViewModel>

@{
    ViewData["Title"] = "Movies";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h1>Movies</h1>
        <p class="text-muted mb-0">
            Manage the movies available for scheduling.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add movie
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

@if (ViewBag.ApiError is string error)
{
    <div class="alert alert-warning" role="alert">
        <p>@error</p>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">
            Try again
        </a>
    </div>
}
else if (Model.Count == 0)
{
    <div class="alert alert-info">
        No movies have been added yet. Select Add movie to get started.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Title</th>
                        <th scope="col">Duration</th>
                        <th scope="col">Pricing</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var movie in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@movie.Title</td>
                            <td>@movie.DurationMinutes minutes</td>
                            <td>
                                @if (movie.IsPremium)
                                {
                                    <span class="badge bg-primary">
                                        Premium
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">
                                        Standard
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index">
        Back to dashboard
    </a>
</div>