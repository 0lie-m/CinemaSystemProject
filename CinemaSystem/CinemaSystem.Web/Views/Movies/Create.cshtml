@model CinemaSystem.Web.Models.MovieViewModel

@{
    ViewData["Title"] = "Add Movie";
}

<div class="mt-4 mb-4">
    <h1>Add movie</h1>
    <p class="text-muted">
        Enter the movie details before assigning it to a showing.
    </p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Movies"
                      asp-action="Create"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Title" class="form-label"></label>
                        <input asp-for="Title"
                               class="form-control"
                               maxlength="200" />
                        <span asp-validation-for="Title"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DurationMinutes"
                               class="form-label"></label>
                        <input asp-for="DurationMinutes"
                               class="form-control"
                               type="number"
                               min="1"
                               max="1440" />
                        <span asp-validation-for="DurationMinutes"
                              class="text-danger"></span>
                    </div>

                    <div class="form-check mb-2">
                        <input asp-for="IsPremium"
                               class="form-check-input"
                               aria-describedby="premium-help" />
                        <label asp-for="IsPremium"
                               class="form-check-label"></label>
                    </div>

                    <p id="premium-help" class="text-muted small mb-4">
                        Premium movies add €2 to the base ticket price
                        before demand adjustments and ticket discounts.
                    </p>

                    <button type="submit" class="btn btn-primary">
                        Save movie
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Back to movies
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}