@model List<CinemaSystem.Web.Models.ScreenViewModel>

@{
    ViewData["Title"] = "Screens";
}

<div class="d-flex justify-content-between align-items-center mb-4 mt-4">
    <div>
        <h1>Screens</h1>
        <p class="text-muted mb-0">
            Manage cinema screens and their seating capacity.
        </p>
    </div>

    <a asp-action="Create" class="btn btn-primary">
        Add screen
    </a>
</div>

@if (TempData["SuccessMessage"] is string message)
{
    <div class="alert alert-success" role="status">
        @message
    </div>
}

@if (ViewBag.ApiError is string error)
{
    <div class="alert alert-warning" role="alert">
        <p>@error</p>
        <a asp-action="Index" class="btn btn-outline-dark btn-sm">
            Try again
        </a>
    </div>
}
else if (Model.Count == 0)
{
    <div class="alert alert-info">
        No screens have been added yet. Select Add screen to get started.
    </div>
}
else
{
    <div class="card shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Screen</th>
                        <th scope="col">Seating capacity</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var screen in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@screen.Name</td>
                            <td>@screen.Capacity seats</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-controller="Home" asp-action="Index">
        Back to dashboard
    </a>
</div>