@model CinemaSystem.Web.Models.CreateScreenViewModel

@{
    ViewData["Title"] = "Add Screen";
}

<div class="mt-4 mb-4">
    <h1>Add screen</h1>
    <p class="text-muted">
        Enter a screen name and the number of seats it contains.
    </p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-controller="Screens"
                      asp-action="Create"
                      method="post">

                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name"
                               class="form-control"
                               maxlength="100" />
                        <span asp-validation-for="Name"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Capacity"
                               class="form-label"></label>
                        <input asp-for="Capacity"
                               class="form-control"
                               type="number"
                               min="1"
                               step="1" />
                        <span asp-validation-for="Capacity"
                              class="text-danger"></span>
                    </div>

                    <button type="submit" class="btn btn-primary">
                        Save screen
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary ms-2">
                        Back to screens
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}