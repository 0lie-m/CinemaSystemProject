@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cinema System</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/CinemaSystem.Web.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-md navbar-dark bg-dark shadow-sm mb-3"
             aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Cinema System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto">
                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Home" ? "active" : "")"
                               aria-current="@(currentController == "Home" ? "page" : null)"
                               asp-area=""
                               asp-controller="Home"
                               asp-action="Index">
                                Dashboard
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Movies" ? "active" : "")"
                               aria-current="@(currentController == "Movies" ? "page" : null)"
                               asp-area=""
                               asp-controller="Movies"
                               asp-action="Index">
                                Movies
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Screens" ? "active" : "")"
                               aria-current="@(currentController == "Screens" ? "page" : null)"
                               asp-area=""
                               asp-controller="Screens"
                               asp-action="Index">
                                Screens
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link @(currentController == "Showings" ? "active" : "")"
                               aria-current="@(currentController == "Showings" ? "page" : null)"
                               asp-area=""
                               asp-controller="Showings"
                               asp-action="Index">
                                Showings
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Cinema System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>