@{
    var currentController =
        ViewContext.RouteData.Values["controller"]?.ToString();

    var currentAction =
        ViewContext.RouteData.Values["action"]?.ToString();

    var sellingTickets = currentController == "Bookings" &&
        (currentAction == "Create" ||
         currentAction == "Quote" ||
         currentAction == "Confirm");

    var viewingBookings =
        currentController == "Bookings" && !sellingTickets;

    var navigation = new[]
    {
        new { Label = "Dashboard", Controller = "Home",
            Action = "Index", Active = currentController == "Home" },
        new { Label = "Movies", Controller = "Movies",
            Action = "Index", Active = currentController == "Movies" },
        new { Label = "Screens", Controller = "Screens",
            Action = "Index", Active = currentController == "Screens" },
        new { Label = "Showings", Controller = "Showings",
            Action = "Index", Active = currentController == "Showings" },
        new { Label = "Sell Tickets", Controller = "Bookings",
            Action = "Create", Active = sellingTickets },
        new { Label = "Bookings", Controller = "Bookings",
            Action = "Index", Active = viewingBookings }
    };
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Cinema System</title>

    <script type="importmap"></script>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />
    <link rel="stylesheet"
          href="~/CinemaSystem.Web.styles.css"
          asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark shadow-sm mb-3"
             aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand fw-bold"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">
                    Cinema System
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto">
                        @foreach (var item in navigation)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(item.Active ? "active" : "")"
                                   aria-current="@(item.Active ? "page" : null)"
                                   asp-area=""
                                   asp-controller="@item.Controller"
                                   asp-action="@item.Action">
                                    @item.Label
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-5">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; @DateTime.Now.Year - Cinema System
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>