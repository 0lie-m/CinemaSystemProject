@model CinemaSystem.Web.Models.BookingFormViewModel

@{
    ViewData["Title"] = "Review Booking";
}

<h1 class="mt-4">Review booking</h1>

<div class="card shadow-sm mt-3">
    <div class="card-body p-4">
        <h2 class="h5">@Model.ShowingDescription</h2>

        <dl class="row mt-4">
            <dt class="col-sm-4">Ticket type</dt>
            <dd class="col-sm-8">@Model.TicketType</dd>

            <dt class="col-sm-4">Quantity</dt>
            <dd class="col-sm-8">@Model.Quantity</dd>

            <dt class="col-sm-4">Price per ticket</dt>
            <dd class="col-sm-8">€@Model.Quote!.UnitPrice.ToString("0.00")</dd>

            <dt class="col-sm-4">Total</dt>
            <dd class="col-sm-8 fw-bold fs-4">
                €@Model.Quote!.TotalPrice.ToString("0.00")
            </dd>
        </dl>

        <p class="text-muted">
            This quote does not reserve seats. Availability and price
            will be checked again when you confirm.
            If the price changes, you will need a new quote.
        </p>

        <form asp-action="Confirm" method="post">
            <input asp-for="ShowingId" type="hidden" />
            <input asp-for="TicketType" type="hidden" />
            <input asp-for="Quantity" type="hidden" />
            <input asp-for="ExpectedTotalPrice" type="hidden" />

            <button type="submit" class="btn btn-success">
                Confirm booking
            </button>

            <a asp-action="Create" class="btn btn-outline-secondary">
                Start again
            </a>
        </form>
    </div>
</div>