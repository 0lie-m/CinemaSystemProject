@model CinemaSystem.Web.Models.CreateShowingViewModel

@{
    ViewData["Title"] = "Schedule Showing";
}

<div class="mt-4 mb-4">
    <h1>Schedule showing</h1>
    <p class="text-muted">
        Choose a movie, screen and start time.
        The end time is calculated from the movie's duration.
    </p>
</div>

<div class="row">
    <div class="col-md-7 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    <div asp-validation-summary="ModelOnly"
                         class="text-danger mb-3"
                         role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="MovieId" class="form-label"></label>
                        <select asp-for="MovieId"
                                asp-items="Model.Movies"
                                class="form-select">
                            <option value="">Choose a movie</option>
                        </select>
                        <span asp-validation-for="MovieId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ScreenId" class="form-label"></label>
                        <select asp-for="ScreenId"
                                asp-items="Model.Screens"
                                class="form-select">
                            <option value="">Choose a screen</option>
                        </select>
                        <span asp-validation-for="ScreenId"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="StartTime" class="form-label"></label>
                        <input asp-for="StartTime"
                               type="datetime-local"
                               class="form-control" />
                        <span asp-validation-for="StartTime"
                              class="text-danger"></span>
                        <div class="form-text">Use cinema local time.</div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="BasePrice" class="form-label"></label>
                        <input asp-for="BasePrice"
                               type="number"
                               min="0"
                               step="0.01"
                               class="form-control" />
                        <span asp-validation-for="BasePrice"
                              class="text-danger"></span>
                    </div>

                    @if (Model.Movies.Count > 0 && Model.Screens.Count > 0)
                    {
                        <button type="submit" class="btn btn-primary">
                            Save showing
                        </button>
                    }
                    else
                    {
                        <p class="text-warning">
                            Movies and screens must be available before
                            you can schedule a showing.
                        </p>
                    }

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Back to showings
                    </a>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}