@model List<CinemaSystem.Web.Models.ShowingViewModel>

@{
    ViewData["Title"] = "Cinema Dashboard";
}

<div class="py-4">
    <p class="text-uppercase text-muted mb-1">Cinema management</p>
    <h1 class="display-5 fw-bold">Cinema Dashboard</h1>
    <p class="lead text-muted">
        View scheduled movies and current ticket availability.
    </p>
</div>

@if (ViewBag.ApiError is string error)
{
    <div class="alert alert-warning" role="alert">
        <p class="mb-2">@error</p>
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-outline-dark btn-sm">
            Try again
        </a>
    </div>
}
else
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Scheduled showings</h2>
                    <p class="display-6 mb-0">@Model.Count</p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Tickets sold across showings</h2>
                    <p class="display-6 mb-0">
                        @Model.Sum(showing => showing.SeatsSold)
                    </p>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted">Available seats across showings</h2>
                    <p class="display-6 mb-0">
                        @Model.Sum(showing => showing.AvailableSeats)
                    </p>
                </div>
            </div>
        </div>
    </div>

    <h2 class="h4 mb-3">Showings</h2>

    @if (Model.Count == 0)
    {
        <div class="alert alert-info">
            No showings have been scheduled yet.
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Movie</th>
                            <th scope="col">Screen</th>
                            <th scope="col">Starts</th>
                            <th scope="col">Ends</th>
                            <th scope="col">Base price</th>
                            <th scope="col">Seats available</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var showing in Model)
                        {
                            <tr>
                                <td class="fw-semibold">
                                    @showing.MovieTitle
                                </td>
                                <td>@showing.ScreenName</td>
                                <td>
                                    @showing.StartTime.ToString("dd MMM yyyy HH:mm")
                                </td>
                                <td>
                                    @showing.EndTime.ToString("dd MMM yyyy HH:mm")
                                </td>
                                <td>€@showing.BasePrice.ToString("0.00")</td>
                                <td>
                                    @if (showing.AvailableSeats <= 0)
                                    {
                                        <span class="badge bg-danger">
                                            Sold out
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            @showing.AvailableSeats / @showing.Capacity
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <p class="text-muted small mt-3">
            Times are cinema local time. Base prices exclude ticket-type
            discounts and premium or demand adjustments.
        </p>
    }
}